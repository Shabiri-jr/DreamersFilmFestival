# Public browser-safe Supabase configuration.
# The anon key is intentionally public; Row Level Security remains the boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical origin used for secure redirects, public pass URLs, and QR payloads.
# Use the final HTTPS domain in production; localhost is accepted for local development.
APP_ORIGIN=http://localhost:3000

# Server-only HMAC secret for the 30-day referral attribution token.
# Generate at least 32 random characters; changing it invalidates old tokens.
REFERRAL_ATTRIBUTION_SECRET=replace-with-at-least-32-random-characters

# Server-only HMAC secret for protecting access to customer payment summaries.
ORDER_ACCESS_SECRET=replace-with-a-different-32-character-secret
